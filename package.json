{
  "name": "frontend-interview-boilerplate",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "14.2.10",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-query": "3.25.1",
    "zustand": "3.6.5",
    "next-usequerystate": "1.7.2",
    "query-string": "7.0.1",
    "clsx": "2.0.0",
    "tailwind-merge": "0.9.0",
    "es-toolkit": "1.39.5"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "^20",
    "@types/react": "17.0.26",
    "@types/react-dom": "17.0.10",
    "tailwindcss": "3.4.17",
    "postcss": "^8.5.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.1",
    "@eslint/eslintrc": "3.3.7",
    "eslint-config-next": "14.2.10",
    "eslint-plugin-tailwindcss": "3.18.2",
    "typescript-eslint": "8.48.1",
    "eslint-plugin-promise": "7.2.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.7.4",
    "vitest": "3.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "vite": "6.0.7",
    "vite-tsconfig-paths": "6.1.1",
    "jsdom": "30.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.6"
  }
}
